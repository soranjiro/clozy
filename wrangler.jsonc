{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clozy",
  "pages_build_output_dir": "./apps/web/dist",
  "compatibility_date": "2026-10-31",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clozy-v2",
      "database_id": "6c007911-64b3-47eb-b7be-06a43d12d609"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BACKUPS",
      "bucket_name": "clozy-private-v2"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "clozy-v2-preview",
          "database_id": "9e9e4db1-109f-4ddd-88d2-d36bb8c4f8f1"
        }
      ],
      "r2_buckets": [
        {
          "binding": "BACKUPS",
          "bucket_name": "clozy-private-preview"
        }
      ],
      "vars": {
        "FIREBASE_PROJECT_ID": "clozy-6166b",
        "FIREBASE_WEB_CONFIG": "{\"projectId\":\"clozy-6166b\",\"appId\":\"1:490566218530:web:8c3a9550d7255fcda4ab7b\",\"apiKey\":\"AIzaSyD9u3LsLA9ipDT6GRps-aAdHSp37oR4OQc\",\"authDomain\":\"clozy-6166b.firebaseapp.com\"}"
      }
    }
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "clozy-6166b",
    "FIREBASE_WEB_CONFIG": "{\"projectId\":\"clozy-6166b\",\"appId\":\"1:490566218530:web:8c3a9550d7255fcda4ab7b\",\"apiKey\":\"AIzaSyD9u3LsLA9ipDT6GRps-aAdHSp37oR4OQc\",\"authDomain\":\"clozy-6166b.firebaseapp.com\"}"
  }
}
