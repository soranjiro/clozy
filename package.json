{
  "name": "clozy",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev -w @clozy/web",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run",
    "build": "npm run typecheck && npm run build -w @clozy/web",
    "preview": "npm run preview -w @clozy/web",
    "improve:watch": "node scripts/improve-loop.mjs",
    "verify": "node scripts/improve-loop.mjs --once",
    "test:browser": "node scripts/browser-smoke.mjs",
    "improve:auto": "node scripts/autopilot.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
